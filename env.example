# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_BOT_USERNAME: The Telegram bot username (e.g. ferma_a11_bot)
VITE_BOT_USERNAME="ferma_a11_bot"

# TELEGRAM_BOT_TOKEN: Server-side bot token (never exposed to client)
TELEGRAM_BOT_TOKEN=""

